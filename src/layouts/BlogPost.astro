---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import { useTranslations, getLangFromUrl } from "../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

type Props = CollectionEntry<"blog">["data"] & {
  headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, tags, headings = [] } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={description}>
  <div class="post-layout">
    <article class="blog-post">
      <header>
        <h1>{title}</h1>
        <div class="meta">
          <span>
            {t("post.publishedOn")}
            <time datetime={pubDate.toISOString()}>
              {
                pubDate.toLocaleDateString(lang, {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })
              }
            </time>
          </span>
          {
            updatedDate && (
              <span class="updated">
                {t("post.updatedOn")}{" "}
                <time datetime={updatedDate.toISOString()}>
                  {updatedDate.toLocaleDateString(lang, {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
              </span>
            )
          }
        </div>
        {
          tags && tags.length > 0 && (
            <div class="tags">
              {tags.map((tag: string) => (
                <a href={getRelativeLocaleUrl(lang, `tags/${tag}`)} class="tag">
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
      </header>
      <div class="content">
        <slot />
      </div>
    </article>

    {
      tocHeadings.length > 0 && (
        <aside class="toc-sidebar">
          <nav class="toc">
            <p class="toc-title">{t("toc.title")}</p>
            <ul>
              {tocHeadings.map((heading) => (
                <li class={`toc-item depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</BaseLayout>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }
  .blog-post {
    min-width: 0;
  }
  @media (min-width: 860px) {
    .post-layout {
      grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
      gap: 4rem;
    }
    .toc-sidebar {
      position: sticky;
      top: 2rem;
      align-self: start;
    }
  }
  .blog-post header {
    margin-bottom: 3rem;
    text-align: center;
  }
  .blog-post h1 {
    font-size: clamp(1.6rem, 4.5vw, 2.5rem);
    margin-bottom: 1rem;
    margin-top: 0;
  }
  .meta {
    font-size: 0.9rem;
    color: var(--text-secondary);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .tag {
    font-size: 0.85rem;
    color: var(--light);
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    padding: 0.2rem 0.65rem;
    border-radius: 1rem;
    transition: all var(--transition-speed) ease;
    text-decoration: none;
  }
  .tag:hover {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--tag-hover-color);
    transform: translateY(-1px);
  }
  .content {
    line-height: 1.8;
    word-break: break-word;
  }
  .content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }
  .content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .toc-sidebar {
    display: none;
  }
  @media (min-width: 860px) {
    .toc-sidebar {
      display: block;
    }
  }
  .toc-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--card-border);
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .toc-item {
    margin-bottom: 0;
  }
  .toc-item a {
    display: block;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.3rem 0;
    line-height: 1.4;
    border-left: 2px solid transparent;
    padding-left: 0.75rem;
    transition: all var(--transition-speed) ease;
  }
  .toc-item a:hover {
    color: var(--light);
    border-left-color: var(--accent);
  }
  .toc-item.depth-3 a {
    padding-left: 1.5rem;
    font-size: 0.8rem;
  }
  .toc-item a.active {
    color: var(--light);
    border-left-color: var(--accent);
    font-weight: 600;
  }
</style>

<script>
  // 目录滚动监听
  const headingEls = Array.from(
    document.querySelectorAll<HTMLElement>(".content h2[id], .content h3[id]"),
  );
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc-item a"));

  if (headingEls.length && tocLinks.length) {
    function updateActive() {
      const scrollY = window.scrollY + 120;
      let activeId = headingEls[0].id;
      for (const h of headingEls) {
        if (h.offsetTop <= scrollY) activeId = h.id;
      }
      tocLinks.forEach((link) => {
        link.classList.toggle("active", link.getAttribute("href") === `#${activeId}`);
      });
    }
    window.addEventListener("scroll", updateActive, { passive: true });
    updateActive();
  }

  // 代码块复制按钮
  const codeBlocks = Array.from(document.querySelectorAll("pre"));
  for (const codeBlock of codeBlocks) {
    const copyBtn = document.createElement("button");
    copyBtn.className = "copy-button";
    copyBtn.type = "button";
    copyBtn.ariaLabel = "复制代码";
    copyBtn.innerHTML =
      '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
    codeBlock.appendChild(copyBtn);

    copyBtn.addEventListener("click", async () => {
      const code = codeBlock.querySelector("code");
      const text = code ? code.innerText : codeBlock.innerText;
      try {
        await navigator.clipboard.writeText(text);
        copyBtn.classList.add("copied");
        copyBtn.innerHTML =
          '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        setTimeout(() => {
          copyBtn.classList.remove("copied");
          copyBtn.innerHTML =
            '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
        }, 2000);
      } catch (err) {
        console.error("复制失败:", err);
      }
    });
  }
</script>
