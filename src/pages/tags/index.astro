---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { CATEGORIES, UNCATEGORIZED } from "../../config";

const posts: CollectionEntry<"blog">[] = await getCollection("blog");

// 只有 categories 才参与分类统计；tags 仅作展示，不在这里出现
const countByCategory = (category: string) =>
  posts.filter((post) => (post.data.categories ?? []).includes(category)).length;

const uncategorizedCount = posts.filter((post) => (post.data.categories ?? []).length === 0).length;

// 按白名单固定顺序展示（0 篇的也列出并置灰，方便知道有哪些分类可用）
const categoryCards = CATEGORIES.map((category) => ({
  name: category,
  count: countByCategory(category),
}));
---

<BaseLayout title="分类标签" description="按主题探索文章。">
  <section class="tags-header">
    <h1>分类标签</h1>
    <p>按主题探索文章。</p>
  </section>
  <section class="tags-container">
    <div class="tags-grid">
      <a href={`/tags/${UNCATEGORIZED}/`} class="tag-card">
        <span class="tag-name">#{UNCATEGORIZED}</span>
        <span class="tag-count">{uncategorizedCount} 篇</span>
      </a>
      {
        categoryCards.map(({ name, count }) => (
          <a href={`/tags/${name}/`} class={`tag-card${count === 0 ? " is-empty" : ""}`}>
            <span class="tag-name">#{name}</span>
            <span class="tag-count">{count} 篇</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .tags-header {
    margin-bottom: 3rem;
  }
  .tags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }
  .tag-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    text-decoration: none;
    transition: all var(--transition-speed) ease;
  }
  .tag-card:hover {
    background: var(--card-hover-bg);
    border-color: var(--light);
    transform: translateY(-2px);
  }
  /* 0 篇的分类：置灰但仍然可点，方便知道白名单里有哪些分类可用 */
  .tag-card.is-empty {
    opacity: 0.45;
  }
  .tag-card.is-empty:hover {
    opacity: 0.8;
  }
  .tag-name {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--light);
    margin-bottom: 0.25rem;
  }
  .tag-count {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
</style>
