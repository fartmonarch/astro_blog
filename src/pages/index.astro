---
import BaseLayout from "../layouts/BaseLayout.astro";
import Profile from "../components/Profile.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const pageTitle = "沫之白的小窝";
const pageDescription = "一个极简 Astro 博客主题，剥离干扰，拉近作者与读者的距离。";

const posts: CollectionEntry<"blog">[] = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="home-layout">
    <aside class="sidebar">
      <Profile />
    </aside>
    <div class="content-area">
      <section class="recent-posts">
        <h2>归档</h2>
        <div class="posts-container">
          <ul>
            {
              posts.map((post) => {
                return (
                  <li>
                    <a href={`/blog/${post.id}/`}>
                      <span class="title">{post.data.title}</span>
                      <span class="date">
                        {post.data.pubDate.toLocaleDateString("zh-CN", {
                          year: "numeric",
                          month: "long",
                          day: "numeric",
                        })}
                      </span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
          <div class="fade-more">
            <a href="/archive/" class="more-link">
              全部文章 →
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .home-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }
  .sidebar {
    align-self: start;
  }
  @media (min-width: 860px) {
    .home-layout {
      grid-template-columns: 1fr 3fr;
      gap: 4rem;
    }
    .sidebar {
      position: sticky;
      top: 2rem;
    }
  }
  .recent-posts h2 {
    font-size: 1.25rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
    margin-top: 0;
    margin-bottom: 1.5rem;
  }
  .posts-container {
    position: relative;
    max-height: 520px;
    overflow: hidden;
  }
  ul {
    list-style-type: none;
    padding: 0;
  }
  li {
    margin-bottom: 0.75rem;
  }
  li a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    padding: 0.75rem 0.9rem;
    border-radius: 8px;
    border: 1px solid transparent;
    transition: all var(--transition-speed) ease;
  }
  li a:hover {
    background: var(--card-hover-bg);
    border-color: var(--card-border);
    transform: translateX(4px);
  }
  .title {
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    font-weight: 600;
    color: var(--light);
    margin-bottom: 0.3rem;
    transition: color 0.3s ease;
  }
  .date {
    font-size: 0.82rem;
    color: var(--text-secondary);
    transition: color 0.3s ease;
  }
  .fade-more {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 90px;
    background: var(--bg-color);
    mask: linear-gradient(to bottom, transparent 0%, black 65%);
    -webkit-mask: linear-gradient(to bottom, transparent 0%, black 65%);
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    pointer-events: none;
    transition: background-color 0.3s ease;
  }
  .more-link {
    font-size: 0.9rem;
    color: var(--text-secondary);
    pointer-events: auto;
  }
  .more-link:hover {
    color: var(--light);
  }
  @media (min-width: 640px) {
    li a {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    .title {
      margin-bottom: 0;
    }
  }
</style>
