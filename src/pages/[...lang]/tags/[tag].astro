---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { ui, defaultLang } from "../../../i18n/ui";
import { useTranslations } from "../../../i18n/utils";
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const paths = allPosts.flatMap((post) => {
    const [postLang] = post.id.split("/");
    const lang = postLang === defaultLang ? undefined : postLang;
    return (post.data.tags || []).map((tag) => ({ params: { lang, tag } }));
  });
  const uniquePaths = Array.from(
    new Map(paths.map((p) => [`${p.params.lang || "default"}-${p.params.tag}`, p.params])).values(),
  );
  return uniquePaths.map((p) => ({ params: { lang: p.lang, tag: p.tag } }));
}

const { lang, tag } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof ui);

const posts = await getCollection("blog", (post) => {
  return post.id.startsWith(`${currentLang}/`) && (post.data.tags || []).includes(tag);
});
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`#${tag}`} description={`标签 "${tag}" 下的全部文章`}>
  <div class="tag-header">
    <a href={getRelativeLocaleUrl(currentLang, "tags")} class="back-link">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      {t("tags.title")}
    </a>
    <h1>#{tag}</h1>
  </div>
  <section class="posts-list">
    {
      posts.length > 0 ? (
        <ul>
          {posts.map((post) => {
            const slugWithoutLang = post.id.replace(`${currentLang}/`, "");
            return (
              <li>
                <a href={getRelativeLocaleUrl(currentLang, `blog/${slugWithoutLang}`)}>
                  <span class="title">{post.data.title}</span>
                  <span class="date">
                    {post.data.pubDate.toLocaleDateString(currentLang, {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p>该标签下暂无文章。</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .tag-header {
    margin-bottom: 3rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--light);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: all var(--transition-speed) ease;
  }
  .back-link:hover {
    color: var(--heading-color);
    transform: translateX(-3px);
  }
  h1 {
    margin-top: 0;
  }
  ul {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }
  li {
    margin-bottom: 0;
  }
  li a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--card-border);
    transition: all var(--transition-speed) ease;
  }
  li a:hover {
    padding-left: 0.5rem;
  }
  li a:hover .title {
    color: var(--text-color);
  }
  .title {
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    font-weight: 600;
    color: var(--light);
  }
  .date {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-top: 0.15rem;
  }
  @media (min-width: 640px) {
    li a {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    .date {
      margin-top: 0;
      flex-shrink: 0;
      margin-left: 1rem;
    }
  }
</style>
