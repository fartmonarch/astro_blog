---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const pageTitle = "项目";
const pageDescription = "我发布过的仓库与工程：源码、上线地址、npm 包。";

const projects: CollectionEntry<"project">[] = await getCollection("project");

// 顺序：精选优先 → 名称。用名称兜底是为了构建结果稳定可复现
// （Sveltia 目前没有文件夹集合的手动排序，没法直接读用户拖出来的顺序）。
projects.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.title.localeCompare(b.data.title, "zh-CN");
});
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="projects-header">
    <h1>{pageTitle}</h1>
    <p>{pageDescription}</p>
  </section>

  {
    projects.length === 0 ? (
      <p class="empty">还没有项目。去 /admin/ → 项目 → New 项目 添加第一条。</p>
    ) : (
      <div class="projects-grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    )
  }
</BaseLayout>

<style>
  .projects-header {
    margin-bottom: 3rem;
  }
  .empty {
    color: var(--text-secondary);
  }

  /* 一行两个：窄屏退化成一行一个 */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: stretch;
  }
  @media (min-width: 860px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
