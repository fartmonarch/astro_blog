---
import { SITE_CONFIG } from "../config";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header">
  <nav>
    <div class="logo">
      <a href="/">{SITE_CONFIG.title}</a>
    </div>
    <div class="links">
      <a href="/">首页</a>
      <a href="/projects/">项目</a>
      <a href="/archive/">归档</a>
      <a href="/tags/">标签</a>
      <a href="/about/">关于</a>
    </div>
    <div class="nav-actions">
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .site-header {
    width: var(--site-width);
    padding: 1.5rem 0;
    margin-left: auto;
    margin-right: auto;
  }
  nav {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .logo {
    flex-shrink: 0;
  }
  .logo a {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--heading-color) !important;
  }
  .logo a:hover {
    color: var(--accent);
  }
  .links {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 1.5rem;
    white-space: nowrap;
  }
  .links a {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--light);
  }
  .links a:hover {
    color: var(--heading-color);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-left: auto;
    flex-shrink: 0;
  }
  @media (min-width: 640px) {
    nav {
      flex-wrap: nowrap;
    }
    .nav-actions {
      margin-left: auto;
    }
  }
  @media (max-width: 639px) {
    .links {
      position: static;
      transform: none;
      order: 3;
      width: 100%;
      justify-content: center;
    }
    .nav-actions {
      margin-left: auto;
    }
  }
</style>
