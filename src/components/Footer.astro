---
import { getLangFromUrl } from "../i18n/utils";
import { AUTHOR } from "../config";

const today = new Date();
const lang = getLangFromUrl(Astro.url);
const footerText = {
  zh: "极简。实用。值得分享。",
  en: "Minimal. Practical. Worth Sharing.",
};
const text = footerText[lang as keyof typeof footerText] || footerText.en;
---

<footer class="site-footer">
  <p>&copy; {today.getFullYear()} {AUTHOR.name}. {text}</p>
</footer>

<style>
  .site-footer {
    width: var(--site-width);
    padding: 2rem 0;
    text-align: center;
    border-top: 1px solid var(--border-color);
    margin-top: 4rem;
    margin-left: auto;
    margin-right: auto;
  }
  p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
  }
</style>
