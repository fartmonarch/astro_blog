---
/**
 * 品牌 / 通用小图标：SVG path 直接内联，不依赖 astro-icon 与它的虚拟模块。
 *
 * 为什么不走 astro-icon：本项目里 astro-icon 的本地图标集（src/icons/）加载不出来，
 * 会报 `Unable to load the "local" icon set!`（它的 Vite 插件把异常吞掉了，
 * 于是虚拟模块导出 undefined）。卡片上一共就这几个图标，内联最省事也最稳。
 *
 * 路径来源：GitHub / Gitee / npm 取自 Simple Icons（CC0），另外两个是通用符号。
 */
export interface Props {
  name: "github" | "gitee" | "npm" | "external" | "source";
  title?: string;
}

const { name, title } = Astro.props;

const paths: Record<Props["name"], string> = {
  github:
    "M12 .297c-6.63 0-12 5.373-12 12c0 5.303 3.438 9.8 8.205 11.385c.6.113.82-.258.82-.577c0-.285-.01-1.04-.015-2.04c-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729c1.205.084 1.838 1.236 1.838 1.236c1.07 1.835 2.809 1.305 3.495.998c.108-.776.417-1.305.76-1.605c-2.665-.3-5.466-1.332-5.466-5.93c0-1.31.465-2.38 1.235-3.22c-.135-.303-.54-1.523.105-3.176c0 0 1.005-.322 3.3 1.23c.96-.267 1.98-.399 3-.405c1.02.006 2.04.138 3 .405c2.28-1.552 3.285-1.23 3.285-1.23c.645 1.653.24 2.873.12 3.176c.765.84 1.23 1.91 1.23 3.22c0 4.61-2.805 5.625-5.475 5.92c.42.36.81 1.096.81 2.22c0 1.606-.015 2.896-.015 3.286c0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  gitee:
    "M11.984 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12a12 12 0 0 0 12-12A12 12 0 0 0 12 0zm6.09 5.333c.328 0 .593.266.592.593v1.482a.594.594 0 0 1-.593.592H9.777c-.982 0-1.778.796-1.778 1.778v5.63c0 .327.266.592.593.592h5.63c.982 0 1.778-.796 1.778-1.778v-.296a.593.593 0 0 0-.592-.593h-4.15a.59.59 0 0 1-.592-.592v-1.482a.593.593 0 0 1 .593-.592h6.815c.327 0 .593.265.593.592v3.408a4 4 0 0 1-4 4H5.926a.593.593 0 0 1-.593-.593V9.778a4.444 4.444 0 0 1 4.445-4.444h8.296Z",
  npm: "M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019l-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z",
  // mdi:open-in-new
  external:
    "M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z",
  // mdi:source-repository
  source:
    "M6,2H18A2,2 0 0,1 20,4V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V4A2,2 0 0,1 6,2M12.5,5.5V7.5H17V5.5H12.5M12.5,9.5V11.5H17V9.5H12.5M12.5,13.5V15.5H17V13.5H12.5M12.5,17.5V19.5H17V17.5H12.5M7,5.5V19.5H11V5.5H7Z",
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="currentColor"
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  width="16"
  height="16"
>
  {title && <title>{title}</title>}
  <path d={paths[name]}></path>
</svg>

<style>
  svg {
    display: block;
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }
</style>
